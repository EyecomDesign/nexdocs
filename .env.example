# ──────────────────────────────────────────────────────────────────────────────
# Clerk — Authentication
# Create a Clerk application at https://clerk.com
# Use a separate Clerk instance per environment (dev / staging / production)
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# ──────────────────────────────────────────────────────────────────────────────
# Database — PostgreSQL
# Local dev: use the Docker Compose instance below
# Railway:   use the Railway-provided connection string (set in Railway dashboard)
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nexdocs:nexdocs@localhost:5432/nexdocs

# ──────────────────────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
