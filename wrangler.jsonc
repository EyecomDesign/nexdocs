{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexdocs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Bindings to add when auth/DB is wired up later:
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<id>" }]
  // "services":   [{ "binding": "WORKER_SELF_REFERENCE", "service": "nexdocs" }]
  // "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "nexdocs-cache" }]
}
