{
  "name": "nexdocs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "next build && pagefind --site .next/server/app --output-path public/_pagefind && opennextjs-cloudflare build --skipNextBuild",
    "preview": "pnpm run build:cf && opennextjs-cloudflare preview",
    "deploy": "pnpm run build:cf && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "next": "16.2.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10",
      "zod": "~4.3.6"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "pagefind",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.95.0"
  }
}
